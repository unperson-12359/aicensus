# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - bypasses RLS. Server-only. Required in production for
# /api/contact and other server-only Supabase writes.
SUPABASE_SERVICE_ROLE_KEY=

# Revalidation webhook secret. Send this as the x-revalidation-secret header.
REVALIDATION_SECRET=

# Site URL
NEXT_PUBLIC_SITE_URL=https://aicensus.co

# Optional: Google Analytics (defaults to production ID if unset)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Sentry error monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional: Contact form email alerts (Resend)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
CONTACT_FROM_EMAIL=AiCensus <onboarding@resend.dev>

# Optional: External newsletter signup URL (Buttondown, ConvertKit, etc.)
NEXT_PUBLIC_NEWSLETTER_URL=
