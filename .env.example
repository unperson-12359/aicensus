# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - bypasses RLS. Server-only. Required in production for
# /api/contact and other server-only Supabase writes.
SUPABASE_SERVICE_ROLE_KEY=

# Revalidation webhook secret. Send this as the x-revalidation-secret header.
REVALIDATION_SECRET=

# Site URL
NEXT_PUBLIC_SITE_URL=https://aicensus.co
